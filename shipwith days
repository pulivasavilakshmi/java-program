
class Solution {
    public int check(int[] nums, int capacity, int days) {
        int sum = 0;
        int can_day = 1;

        for (int i = 0; i < nums.length; i++) {
            if (sum + nums[i] > capacity) {
                can_day++;
                sum = nums[i];
            } else {
                sum += nums[i];
            }
        }

        return can_day <= days ? 1 : 0;
    }

    public int shipWithinDays(int[] nums, int days) {
        int st = 0, en = 0;

        for (int i = 0; i < nums.length; i++) {
            st = Math.max(st, nums[i]);
            en += nums[i];
        }

        int ans = en;

        while (st <= en) {
            int capacity = st + (en - st) / 2;

            int res = check(nums, capacity, days);

            if (res == 1) {
                ans = capacity;
                en = capacity - 1;
            } else {
                st = capacity + 1;
            }
        }

        return ans;
    }
}
