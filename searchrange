class Solution {
    public int[] searchRange(int[] nums, int target) {
        int[] ans = {-1, -1};
        ans[0] = find(nums, target, true); 
        ans[1] = find(nums, target, false); 
        return ans;
    }

    private int find(int[] nums, int target, boolean isLeft) {
        int l = 0, r = nums.length - 1;
        int result = -1;

        while (l <= r) {
            int mid = l + (r - l) / 2;

            if (nums[mid] == target) {
                result = mid;
                if (isLeft) {
                    r = mid - 1;
                } else {
                    l = mid + 1;
                }
            } else if (nums[mid] < target) {
                l = mid + 1;
            } else {
                r = mid - 1;
            }
        }
        return result;
    }
}
