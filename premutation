class Solution {
    public String getPermutation(int n, int k) {

        StringBuilder ans = new StringBuilder();

        int fact = 1;
        for (int i = 1; i < n; i++) {
            fact = fact * i;
        }

        java.util.ArrayList<Integer> arr = new java.util.ArrayList<>();

        for (int i = 1; i <= n; i++) {
            arr.add(i);
        }

        k--;

        while (true) {
            ans.append(arr.get(k / fact));

            arr.remove(k / fact);

            if (arr.size() == 0) {
                break;
            }

            k = k % fact;
            fact = fact / arr.size();
        }

        return ans.toString();
    }
}
