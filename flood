class Solution {
    public int[][] floodFill(int[][] image, int sr, int sc, int color) {
        int ogColor = image[sr][sc];
        if(ogColor==color) return image;
        int rSize = image.length,cSize = image[0].length;
        Queue<int[]>que = new LinkedList<>();
        que.offer(new int[]{sr,sc});
        while(!que.isEmpty()){
            int[] polled = que.poll();
            int pr = polled[0], pc = polled[1];
            if(pr<0||pc<0||pr>=rSize||pc>=cSize||image[pr][pc]!=ogColor)
            continue;
            image[pr][pc]=color;
            que.offer(new int[]{pr+1,pc});
            que.offer(new int[]{pr-1,pc});
            que.offer(new int[]{pr,pc+1});
            que.offer(new int[]{pr,pc-1});

        }
        return image;
    }
}
